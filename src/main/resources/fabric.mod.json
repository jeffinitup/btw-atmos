{
  "schemaVersion": 1,
  "id": "btwatmos",
  "version": "${version}",
  "name": "BTW Atmos",
  "description": "Port of the original MAtmos to Better Than Wolves",
  "authors": [
    "jeffyjamzhd",
    "Hurricaaane"
  ],
  "contact": {
    "homepage": "https://legacyfabric.net/",
    "sources": "https://github.com/Legacy-Fabric/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/btwatmos/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.fabricmc.example.ExampleMod"
    ],
    "btw:addon": [
      "btw.community.example.BTWAtmos"
    ]
  },
  "custom": {
    "btw:addon_prefix": "ATMOS"
  },
  "mixins": [
    "btwatmos.mixins.json"
  ],
  "accessWidener": "btwatmos.accesswidener",
  "depends": {
    "fabricloader": ">=0.14.19",
    "minecraft": "1.6.4"
  }
}
